# ═══════════════════════════════════════════════════════════════
# YOUTUBENEWS - 환경변수 설정
# 이 파일을 .env로 복사하고 실제 키 값을 입력하세요
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# 필수: 스크립트 생성 (Claude)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─────────────────────────────────────────────
# 이미지 생성 엔진 (택1, 기본: fal.ai)
# ─────────────────────────────────────────────

# fal.ai (기본, 빠름)
# https://fal.ai 에서 API 키 발급
FAL_KEY=xxxxx

# DALL-E 3 (고품질)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-xxxxx

# Google Imagen
# https://console.cloud.google.com 에서 발급
GOOGLE_API_KEY=AIzaxxxxx

# ─────────────────────────────────────────────
# TTS 엔진 (택1)
# ─────────────────────────────────────────────

# Google WaveNet (기본)
# 서비스 계정 JSON 파일 경로
# https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ElevenLabs (고품질)
# https://elevenlabs.io 에서 발급
ELEVENLABS_API_KEY=xxxxx

# OpenAI TTS
# OPENAI_API_KEY 와 동일 (위에서 설정)

# ─────────────────────────────────────────────
# YouTube 트렌드 분석
# ─────────────────────────────────────────────

# YouTube Data API v3
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIzaxxxxx

# ─────────────────────────────────────────────
# 선택: 추가 설정
# ─────────────────────────────────────────────

# BGM 폴더 경로 (기본: assets/bgm)
# BGM_FOLDER=assets/bgm

# 프로젝트 저장 폴더 (기본: projects)
# PROJECT_DIR=projects
