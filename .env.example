# API Keys

# Anthropic API Key (Claude - 스크립트 생성) - 필수
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (TTS 음성 합성, DALL-E 이미지) - 필수
OPENAI_API_KEY=your_openai_api_key_here

# Pexels API Key (B-roll 비디오 클립) - 선택적
PEXELS_API_KEY=your_pexels_api_key_here


# ============================================
# 이미지 생성 설정
# ============================================

IMAGE_ENGINE=dalle3    # 이미지 생성 엔진 선택
#
# OpenAI 계열 (즉시 사용 가능):
# - dalle3: DALL-E 3 ($0.04/장, 최고 품질, 안정적) - 권장
# - dalle2: DALL-E 2 ($0.02/장, 빠르고 저렴)
#
# Google 계열 (GEMINI_API_KEY 또는 Vertex AI 필요):
# - gemini_flash: Imagen 3 Fast (빠른 생성)
# - gemini_pro: Imagen 3 (최고 품질)
#
# 기타:
# - placeholder: 무료 테스트용 (단색 배경)

# Gemini API Key (Imagen 3 이미지 생성 - 방법 1) - 선택적
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI 설정 (Imagen 2 이미지 생성 - 방법 2) - 선택적
# 프로젝트 루트에 key.json 파일을 넣기만 하면 자동으로 인증됩니다!
# key.json 파일 위치: /home/user/youtubemaker/key.json
GOOGLE_CLOUD_LOCATION=us-central1


# ============================================
# TTS 음성 합성 설정
# ============================================

# TTS 음성 선택 (기본: OpenAI TTS)
# TTS_VOICE=alloy      # OpenAI: alloy, echo, fable, onyx, nova, shimmer
# TTS_VOICE=google_wavenet_a   # Google Cloud TTS (설정 필요)
# TTS_VOICE=naver_nara         # 네이버 CLOVA Voice (설정 필요)

# ---------- Gemini TTS 전용 키 (선택적) ----------
# ★ TTS와 이미지 할당량을 분리하려면 별도 키 사용
# 설정 안 하면 GEMINI_API_KEY를 공용으로 사용
# GEMINI_TTS_API_KEY=your_gemini_tts_api_key_here

# ---------- 네이버 CLOVA Voice API ----------
# 네이버 클라우드 플랫폼에서 발급: https://www.ncloud.com/
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 네이버 음성 옵션 (TTS_VOICE에 설정):
# 한국어 여성:
#   naver_nara       - 고운, 차분한 여성
#   naver_nara_call  - 고운 여성 (상담원 스타일)
#   naver_nminsang   - 밝고 경쾌한 여성
#   naver_nyejin     - 차분한 여성 아나운서
#   naver_mijin      - 부드러운 여성
#   naver_jinho      - 진지한 여성
#
# 한국어 남성:
#   naver_nwontak    - 따뜻한 남성 ⭐ 역사/시니어 추천
#   naver_nkyungtae  - 침착한 남성
#   naver_njoonyoung - 활기찬 남성
#   naver_nseonghoon - 온화한 남성
#   naver_njihwan    - 차분한 남성
#   naver_njooahn    - 부드러운 남성
#
# 아동/동화용:
#   naver_ndain      - 아이 목소리 ⭐ kids 모드 추천
#   naver_noyj       - 밝은 여성 (동화용)

# ---------- Google Cloud TTS ----------
# Service Account JSON 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json


# ============================================
# 비디오 설정
# ============================================

VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
DEFAULT_DURATION_MINUTES=15

# B-roll Video Settings
BROLL_VIDEO_RATIO=50        # 0-100: 비디오 사용 비율 (0=이미지만, 50=균형, 100=비디오만)


# ============================================
# 시니어 모드 설정
# ============================================

SENIOR_LANGUAGE=ko-KR
SENIOR_VOICE_TONE=warm_slow
SENIOR_SPEECH_SPEED=0.92


# ============================================
# 출력 설정
# ============================================

OUTPUT_DIR=export
KEEP_TEMP_FILES=true


# ============================================
# 로깅 설정
# ============================================

LOG_LEVEL=INFO
LOG_FILE=seniorvideo.log
