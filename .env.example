# API Keys

# Anthropic API Key (Claude - 스크립트 생성) - 필수
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (TTS 음성 합성, DALL-E 이미지) - 선택적
OPENAI_API_KEY=your_openai_api_key_here

# Pexels API Key (B-roll 비디오 클립) - 선택적
PEXELS_API_KEY=your_pexels_api_key_here


# ============================================
# 이미지 생성 설정
# ============================================

IMAGE_ENGINE=dalle3    # 이미지 생성 엔진 선택
#
# OpenAI 계열 (즉시 사용 가능):
# - dalle3: DALL-E 3 ($0.04/장, 최고 품질, 안정적) - 권장
# - dalle2: DALL-E 2 ($0.02/장, 빠르고 저렴)
#
# Google 계열 (GEMINI_API_KEY 또는 Vertex AI 필요):
# - gemini_flash: Imagen 3 Fast (빠른 생성)
# - gemini_pro: Imagen 3 (최고 품질)
#
# 기타:
# - placeholder: 무료 테스트용 (단색 배경)

# Gemini API Key (Imagen 3 이미지 생성 - 방법 1) - 선택적
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI 설정 (Imagen 2 이미지 생성 - 방법 2) - 선택적
# 프로젝트 루트에 key.json 파일을 넣기만 하면 자동으로 인증됩니다!
# key.json 파일 위치: /home/user/youtubemaker/key.json
GOOGLE_CLOUD_LOCATION=us-central1


# ============================================
# TTS 음성 합성 설정
# ============================================

# ---------- Google Cloud TTS (7종) ----------
# Service Account JSON 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google TTS 음성 옵션:
# Wavenet (4종):
#   ko-KR-Wavenet-A  - 여성 Wavenet A
#   ko-KR-Wavenet-B  - 여성 Wavenet B
#   ko-KR-Wavenet-C  - 남성 Wavenet C
#   ko-KR-Wavenet-D  - 남성 Wavenet D
#
# Neural2 (3종):
#   ko-KR-Neural2-A  - 여성 Neural2 A (기본값, 가장 자연스러움)
#   ko-KR-Neural2-B  - 여성 Neural2 B
#   ko-KR-Neural2-C  - 남성 Neural2 C

# ---------- ElevenLabs TTS (12종) ----------
# ElevenLabs API Key
# https://elevenlabs.io 에서 발급
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs 음성 옵션 (다국어 모델 - 한국어 지원):
# 여성:
#   eleven_rachel   - Rachel: 차분한 여성
#   eleven_domi     - Domi: 밝은 여성
#   eleven_bella    - Bella: 부드러운 여성
#   eleven_elli     - Elli: 젊은 여성
#
# 남성:
#   eleven_drew     - Drew: 침착한 남성
#   eleven_clyde    - Clyde: 깊은 남성
#   eleven_paul     - Paul: 뉴스 앵커 남성 ⭐ 뉴스 추천
#   eleven_antoni   - Antoni: 따뜻한 남성
#   eleven_josh     - Josh: 젊은 남성
#   eleven_arnold   - Arnold: 힘있는 남성
#   eleven_adam     - Adam: 깊고 내레이션용 남성 ⭐ 나레이션 추천
#   eleven_sam      - Sam: 활기찬 남성


# ============================================
# 비디오 설정
# ============================================

VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
DEFAULT_DURATION_MINUTES=15

# B-roll Video Settings
BROLL_VIDEO_RATIO=50        # 0-100: 비디오 사용 비율 (0=이미지만, 50=균형, 100=비디오만)


# ============================================
# 출력 설정
# ============================================

OUTPUT_DIR=export
KEEP_TEMP_FILES=true


# ============================================
# 로깅 설정
# ============================================

LOG_LEVEL=INFO
LOG_FILE=newsvideo.log
